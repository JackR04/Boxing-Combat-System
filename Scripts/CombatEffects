
using UnityEngine;

public class CombatEffects : MonoBehaviour
{

    [SerializeField] private ParticleSystem bloodSplatter;

    [SerializeField] private AudioClip[] hitClips;
    [SerializeField] private AudioClip[] blockClips;
    [SerializeField] private AudioClip stunnedClip;
    [SerializeField] private AudioClip missedPunchClip;

    [SerializeField, Range(0f, 1f)] private float hitVolume;
    [SerializeField, Range(0f,1f)] private float blockVolume;

    private AudioSource audioSource;

    private void Awake()
    {
        audioSource = GetComponent<AudioSource>();
    }

    //play a random hit clip and spawn blood
    public void PlayDamage(Vector3 hitPoint, Vector3 attackDirection)
    {
        PlayRandom(hitClips, hitVolume);

        SpawnBlood(hitPoint, attackDirection);
    }

    //play a random block clip
    public void PlayBlock()
    {
        PlayRandom(blockClips, blockVolume);
    }

    //play missed punch clip
    public void PlayMissedPunch()
    {
        audioSource.pitch = Random.Range(0.9f, 1.1f);
        audioSource.PlayOneShot(missedPunchClip);
    }

    //play stun clip when bIsStunned is true
    public void SetStunned(bool bIsStunned)
    {
        if (stunnedClip == null)
        {
            return;
        }
        if (bIsStunned)
        {
            audioSource.PlayOneShot(stunnedClip);
        }
        else
        { 
            audioSource.Stop();
        }
    }

    //Spawns blood splatter particles at the position the punch hits and moving in the direction of attack
    private void SpawnBlood(Vector3 position, Vector3 attackDirection)
    {
        if (bloodSplatter == null)
        { 
            return;
        }

        Quaternion rotation = Quaternion.identity;
        if(attackDirection.sqrMagnitude > 0.001f)
        {
            rotation = Quaternion.LookRotation(attackDirection.normalized);

        }

        ParticleSystem blood = Instantiate(bloodSplatter, position, rotation);
        blood.Play();
    }

    // chooses a random clip from a list and randomises the pitch
    private void PlayRandom(AudioClip[] clips, float volume)
    {
        if (clips == null || clips.Length == 0)
        { 
            return;
        }
        AudioClip clipToPlay = clips[UnityEngine.Random.Range(0, clips.Length)];
        if (clipToPlay == null)
        {
            return;
        }
        audioSource.pitch = UnityEngine.Random.Range(0.9f, 1.1f);
        audioSource.PlayOneShot(clipToPlay, volume);
    }

}
