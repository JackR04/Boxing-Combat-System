using NUnit.Framework;
using System.Collections;
using System.Collections.Generic;
using TMPro;
using UnityEngine;
using UnityEngine.UI;

public class HealthBar : MonoBehaviour
{
    [SerializeField] private GameObject floatingTextPrefab;
    [SerializeField] private Slider healthBarSlider;
    private FighterBase fighterBase;
    private Coroutine slideHealthBarCoroutine;
    [SerializeField] float healthStepPerFrame;
    private List<GameObject> damageTextUsed;
    private void Awake()
    {
        fighterBase = GetComponent<FighterBase>();
        
    }
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        if (healthBarSlider == null)
        {
            Debug.LogError($"Health bar Slider not assigned for {name}");
            return;
        }
        if (fighterBase == null)
        {
            Debug.LogError($"Fighter Base not assigned for {name}");
            return;
        }
        // set max health value for sliders and set the sliders to that
        healthBarSlider.maxValue = fighterBase.GetHealth();
        healthBarSlider.value = healthBarSlider.maxValue;
        damageTextUsed = new List<GameObject>();
    }

    
    //decrease healthbar by the damage and spawn floating damage numbers on the healthbar
    public void DamageHealthBar(float damage)
    {
        if (damage <= 0 || healthBarSlider == null || fighterBase == null)
        {
            return;
        }
        float currentHealth = healthBarSlider.value;
        if (slideHealthBarCoroutine != null)
        {
            StopCoroutine(slideHealthBarCoroutine);
        }
        slideHealthBarCoroutine = StartCoroutine(SlideHealthBar(currentHealth, damage, healthStepPerFrame));

        // spawning damage numbers
        Vector3 floatingTextRandomSpawn = transform.position;
        float rand = Random.Range(-0.5f, 0.5f);
        floatingTextRandomSpawn.x += rand;
        GameObject newText = Instantiate(floatingTextPrefab, floatingTextRandomSpawn, Quaternion.identity);
        newText.GetComponentInChildren<TextMeshProUGUI>().text = damage.ToString();
        //for deleting when enemy dies
        damageTextUsed.Add(newText);
    }
    public void ResetHealthBar()
    { 
        healthBarSlider.value += healthBarSlider.maxValue;
    }

    //animate healthbar sliding, step = how much to go down per frame
    private IEnumerator SlideHealthBar(float currentHealth, float damage, float step)
    {
        float endHealth = currentHealth - damage;
        while (currentHealth > endHealth)
        {
            currentHealth -= step;
            healthBarSlider.value = currentHealth;
            yield return null;
        }
        currentHealth = endHealth;
        healthBarSlider.value = endHealth;
        slideHealthBarCoroutine = null;
    }

    //destroy all floating numbers spawned
    private void OnDestroy()
    {
        foreach (var text in damageTextUsed)
        { 
            Destroy(text);
        }
    }
}
