using UnityEngine;

public class SpawnNextEnemies : MonoBehaviour
{
    [SerializeField] private GameManager gameManagerSCR;

    //spawn enemies when player walks though next level trigger
    private void OnTriggerEnter(Collider other)
    {
        if (other.CompareTag("Player"))
        {
            gameManagerSCR.SpawnEnemies();
            gameManagerSCR.CloseDoors();
            Destroy(gameObject);
        }
    }
}
