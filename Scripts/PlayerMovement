
using UnityEngine;
using UnityEngine.InputSystem;


public class PlayerMovement : MonoBehaviour
{
    private InputAction moveAction;
    private InputAction lookAction;
    private InputAction blockAction;
    private InputAction dodgeAction;
    private InputAction jabAction;
    private InputAction crossAction;
    private InputAction hookAction;
    private InputAction uppercutAction;
    private Rigidbody rb;
    [SerializeField]private InputActionAsset playerInput;
    private Vector2 moveDirection;
    [Header ("Sensitivity")]
    public float baseMoveSpeed = 7.0f;
    [Header("Camera")]
    [SerializeField] private Camera mainCam;
    private Transform camT;
    private bool bIsMoving;
    [Header("Scripts")]
    [SerializeField] private FighterBase playerFighterBase;
    [SerializeField] private AnimatorController animatorController;

    [Header("GroundChecker")]
    [SerializeField] private bool bIsGrounded;
    [SerializeField] private GameObject groundChecker;
    [SerializeField] private LayerMask groundLayer;

    private EnemyBase enemyPlayerIsAttacking;

    // Start is called once before the first execution of Update after the MonoBehaviour is created
    private void Awake()
    {
        // create variables leading to input actions
        playerFighterBase = GetComponent<FighterBase>();
        moveAction = playerInput.FindAction("Move");
        lookAction = playerInput.FindAction("Look");
        blockAction = playerInput.FindAction("Block");
        dodgeAction = playerInput.FindAction("Dodge");
        jabAction = playerInput.FindAction("Jab");
        crossAction = playerInput.FindAction("Cross");
        hookAction = playerInput.FindAction("Hook");
        uppercutAction = playerInput.FindAction("Uppercut");
        rb = GetComponent<Rigidbody>();    
        animatorController = GetComponent<AnimatorController>();
    }

    // can move
    private void OnEnable()
    {
        moveAction.Enable();
        lookAction.Enable();
        blockAction.Enable();
        dodgeAction.Enable();
        jabAction.Enable();
        crossAction.Enable();
        hookAction.Enable();
        uppercutAction.Enable();
        dodgeAction.performed += DoDodge;
        blockAction.performed += OnBlockStart;
        blockAction.canceled += OnBlockRelase;
        jabAction.performed += DoJab;
        crossAction.performed += DoCross;
        hookAction.performed += DoHook;
        uppercutAction.performed += DoUppercut;
    }

    //cant move
    private void OnDisable()
    {
        moveAction.Disable();
        lookAction.Disable();
        blockAction.Disable();
        dodgeAction.Disable();
        jabAction.Disable();
        crossAction.Disable();
        hookAction.Disable();
        uppercutAction.Disable();
        dodgeAction.performed -= DoDodge;
        blockAction.performed -= OnBlockStart;
        blockAction.canceled -= OnBlockRelase;
        crossAction.performed -= DoCross;
        hookAction.performed -= DoHook;
        jabAction.performed -= DoJab;
        uppercutAction.performed -= DoUppercut;
    }
    void Start()
    {
        camT = mainCam.gameObject.transform;
    }

    // Update is called once per frame
    void Update()
    {
        bIsMoving = moveAction.IsPressed();
        if (groundChecker)
        {
            bIsGrounded = Physics.CheckSphere(groundChecker.transform.position, 0.1f, groundLayer); 
        }
        if (animatorController != null)
        {
            animatorController.SetMovementSpeed(Vector2.ClampMagnitude(moveDirection, 1f).magnitude);
        }
        

    }

    

    private void OnCollisionEnter(Collision collision)
    {
        Debug.Log($"{collision.collider.name} collided with {name}");
    }
    private void FixedUpdate()
    {
        if (playerFighterBase != null && (playerFighterBase.bIsDodging || playerFighterBase.bIsStunned))
        {
            return;
        }
        Vector3 Forward = transform.forward;
        Vector3 Right = transform.right;
        //keep up and down movement 0
        Forward.y = 0;
        Right.y = 0;
        Vector3 movement = Forward * moveDirection.y + Right * moveDirection.x;
        movement = Vector3.ClampMagnitude(movement, 1f);
        if(bIsMoving && bIsGrounded)
        {
            float moveSpeed = baseMoveSpeed + (0.1f * playerFighterBase.GetStat(FighterBase.STAT.SPEED));
            Vector3 velocity = movement * moveSpeed;
            velocity.y = rb.linearVelocity.y;
            rb.linearVelocity = velocity;
        }
        else
        {
            // reduce speed to zero when not moving
            Vector3 horizontalVelocity = Vector3.Lerp(new Vector3(rb.linearVelocity.x, 0f, rb.linearVelocity.z), Vector3.zero, 0.4f);
            rb.linearVelocity = new Vector3(horizontalVelocity.x, rb.linearVelocity.y, horizontalVelocity.z);
        }

        // move rigidbody to face camera direction
        float camY = camT.eulerAngles.y;
        Quaternion targetRot = Quaternion.Euler(0f, camY, 0f);
        rb.MoveRotation(targetRot); 


    }
    
    

    private void OnMove(InputValue value)
    {
        moveDirection = value.Get<Vector2>();
        
    }
   
    private void DoDodge(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.Dodge();
        }
    }

    private void OnBlockStart(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.StartBlock();
        }
    }
    private void OnBlockRelase(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        { 
            playerFighterBase.StopBlock();
        }
    }
    private void DoJab(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.Jab();
        }
        if (enemyPlayerIsAttacking)
        {
            //tells enemy player is attacking for reaction decision
            enemyPlayerIsAttacking.PlayerStartedAttack();
        }
    }

    private void DoCross(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.Cross();
        }
        if (enemyPlayerIsAttacking)
        {
            //tells enemy player is attacking for reaction decision
            enemyPlayerIsAttacking.PlayerStartedAttack();
        }
    }
    private void DoHook(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.Hook();
        }
        if (enemyPlayerIsAttacking)
        {
            //tells enemy player is attacking for reaction decision
            enemyPlayerIsAttacking.PlayerStartedAttack();
        }
    }
    private void DoUppercut(InputAction.CallbackContext context)
    {
        if (playerFighterBase)
        {
            playerFighterBase.UpperCut();
            
        }
        if (enemyPlayerIsAttacking)
        {
            //tells enemy player is attacking for reaction decision
            enemyPlayerIsAttacking.PlayerStartedAttack();
        }
    }

    //enemy last attacked will react to further punches
    public void SetCurrentEnemyPlayerIsAttacking(EnemyBase enemy)
    {
        if (enemy == null)
        {
            return;
        }
        enemyPlayerIsAttacking = enemy;
    }

    //reduce movement velocity to zero and stop inputs
    public void DisableMovement()
    {
        if (!enabled)
        {
            return;
        }

        moveDirection = Vector2.zero;
        bIsMoving = false;

        if (rb != null)
        {
            Vector3 velocity = rb.linearVelocity;
            rb.linearVelocity = new Vector3(0f, velocity.y, 0f);
        }
        enabled = false;
    }

    // resart inputs
    public void EnableMovement()
    {
        if (enabled)
        {
            return;
        }
        enabled = true;
    }
}
