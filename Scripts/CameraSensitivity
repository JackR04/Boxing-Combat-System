using Unity.Cinemachine;
using UnityEngine;
using UnityEngine.InputSystem;

public class CameraSensitivity : MonoBehaviour
{
    [Header ("Player Movement")]
    [SerializeField] private PlayerMovement playerMovement;
    [Header ("Camera")]
    [SerializeField] private CinemachineInputAxisController inputAxisController;
    [Header ("Sensitivity")]
    [Min(0.1f), SerializeField] private float mouseSensitivity;
    [Min(0.1f), SerializeField] private float controllerSensitivity;
    private bool bIsUsingControler;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        
    }
    private void Update()
    {
        // check if using controller or mouse input
        InputSystem.onActionChange += InputSystem_onActionChange;
    }

    //pass new sensitivity value
    public void SetSensitivity(float value)
    {
        if (bIsUsingControler)
        {
            controllerSensitivity = value;
            ApplySensitivity();
        }
        else
        { 
            mouseSensitivity = value;
            ApplySensitivity();
        }
    }

    // change input gain to new sensitivity, multiply by 100 for controller, so settings can use one slider
    private void ApplySensitivity()
    {
        if (!bIsUsingControler)
        {
            foreach (var axis in inputAxisController.Controllers)
            {
                if (axis.Name == "Look X (Pan)")
                {
                    axis.Input.Gain = mouseSensitivity;
                }
                else if (axis.Name == "Look Y (Tilt)")
                {
                    axis.Input.Gain = -mouseSensitivity;
                }
            }
        }
        if(bIsUsingControler)
        {
            foreach (var axis in inputAxisController.Controllers)
            {
                if (axis.Name == "Look X (Pan)")
                {
                    axis.Input.Gain = controllerSensitivity *100;
                }
                else if (axis.Name == "Look Y (Tilt)")
                {
                    axis.Input.Gain = -controllerSensitivity *100;
                }
            }
        }
       
    }

    // checks the input device and sets bool bIsUsingController
    private void InputSystem_onActionChange(object arg1, InputActionChange arg2)
    {
        if (arg2 == InputActionChange.ActionPerformed)
        {
            var inputAction = (InputAction)arg1;
            var lastControl = inputAction.activeControl;
            var lastDevice = lastControl.device;
            if (lastDevice is Gamepad)
            {
                bIsUsingControler = true;
                SetSensitivity(controllerSensitivity);
            }
            else
            {
                bIsUsingControler = false;
                SetSensitivity(mouseSensitivity);
            }
             
        }
    }
}
