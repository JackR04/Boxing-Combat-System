using System.Collections;
using UnityEngine;

public class Vignette : MonoBehaviour
{
    [Header("Vignettes")]
    [SerializeField] private CanvasGroup hitVignette;
    [SerializeField] private CanvasGroup stunVignette;
    [SerializeField] private CanvasGroup lowHealthVignette;

    [Header("Hit Effect")]
    [SerializeField, Range(0.0f,1.0f)] private float hitMaxAlpha;
    [SerializeField, Min(0.0f)] private float hitFadeInTime;
    [SerializeField, Min(0.0f)] private float hitFadeOutTime;
    [SerializeField, Min(0.0f)] private float hitHoldTime;

    [Header("Stun Effect")]
    [SerializeField, Range(0.0f, 1.0f)] private float StunMaxAlpha;
    [SerializeField, Min(0.0f)] private float StunFadeTime;

    private Coroutine hitCoroutine;
    private Coroutine stunCoroutine;
    private Coroutine lowHealthCoroutine;
    private void Awake()
    {
        // reduce visability to zero
        if (hitVignette != null)
        {
            hitVignette.alpha = 0f;
        }
        if (stunVignette != null)
        { 
            stunVignette.alpha = 0f;
        }
        if (lowHealthVignette != null)
        {
            lowHealthVignette.alpha = 0f;
        }
    }

    //start the coroutine
    public void ApplyHitVignette()
    {
        if (hitVignette == null)
        {
            return;
        }
        if (hitCoroutine != null)
        { 
            StopCoroutine(hitCoroutine);
        }
        hitCoroutine = StartCoroutine(HitCoroutine());
    }

    // start the coroutine
    public void SetStunVignette(bool bIsStunned)
    {
        if (stunVignette == null)
        {
            return;
        }
        if (stunCoroutine != null)
        {
            StopCoroutine(stunCoroutine);
        }
        float targetAlpha = bIsStunned ? StunMaxAlpha : 0f;
        stunCoroutine = StartCoroutine(FadeVignette(stunVignette, targetAlpha, StunFadeTime));
    }

    // start the coroutine
    public void SetLowHealthVignette(bool bIsLowHealth)
    {
        
        if (lowHealthVignette == null)
        {
            return;
        }
        if (lowHealthCoroutine != null)
        {
            StopCoroutine(lowHealthCoroutine);
        }
        float targetAlpha = bIsLowHealth ? 1 : 0f;
        lowHealthCoroutine = StartCoroutine(FadeVignette(lowHealthVignette, targetAlpha, hitFadeInTime));
    }

    //fade in or out vignette, target alpha 0 = fade out 1 = fade in, duration = fade time
    private IEnumerator FadeVignette(CanvasGroup vignette, float targetAlpha, float duration)
    {
        float startingAlpha = vignette.alpha;
        if (duration <= 0)
        {
            vignette.alpha = targetAlpha;
            yield break;
        }

        float fadeTimer = 0f;
        while (fadeTimer < duration)
        {
            fadeTimer += Time.unscaledDeltaTime;
            float percentage = Mathf.Clamp01(fadeTimer / duration);
            vignette.alpha = Mathf.Lerp(startingAlpha, targetAlpha, percentage);
            yield return null;  
        }
        vignette.alpha = targetAlpha;

    }

    // fade in hit vignette, hold for hitHoldTime, fade out hit vignette
    private IEnumerator HitCoroutine()
    {
        yield return FadeVignette(hitVignette, hitMaxAlpha, hitFadeInTime);
        yield return new WaitForSecondsRealtime(hitHoldTime);
        yield return FadeVignette(hitVignette, 0f, hitFadeOutTime);
        hitCoroutine = null;
    }
}
