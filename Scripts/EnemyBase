using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.AI;
using Random = UnityEngine.Random;


public class EnemyBase : MonoBehaviour
{
    private class attackweight
    {
        public ATTACK attack;
        public int wieght;
        public attackweight(ATTACK newAttack, int newWeight)
        {
            attack = newAttack;
            wieght = newWeight;
        }
    }
    private enum ATTACK
    { 
        JAB,
        CROSS,
        HOOK,
        UPPERCUT,
        NULL,
    }
    private enum ENEMYSTATE
    { 
        ATTACK,
        BLOCK,
        DODGE,
        STUNNED,
        DISTANCE,
        LOWHEALTH,
    }

    private Rigidbody rigidBody;
    private GameObject player;
    private CapsuleCollider playerCollider;
    private FighterBase fighterBase;
    private float moveSpeed = 0.0f;
    private NavMeshAgent agent;
    private FighterBase playerFighterBase;
    private Vector3 startingPos;
    private bool bCanAttack;
    private ATTACK currentAttack;
    private ENEMYSTATE currentState;
    private bool bAttackDecided;
    private bool bAttackIsOnCooldown;
    private bool bIsBlocking;
    private float blockChance;
    private float reactionTime;
    private float dodgeChance;
    private List<attackweight> getAttackWeights;
    private float orbitAngle = 0;
    private float orbitRadius = 7;
    private float updateOrbitInterval = 0.5f;
    private float orbitStepDegrees = 30f;
    private float orbitUpdateTimer;
    private float orbitDirection;
    private bool bIsLowHealth;
    private bool bWantsToBlock;
    private bool bWantsToDodge;
    private bool bDodgeCoroutineRunning;
    private bool bLancerLowHealthCoroutineRunning;
    [SerializeField] private AnimatorController animatorController;
    [SerializeField] private HUD hudScript;
    private HealthBar myHealthBar;
    
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
        myHealthBar = GetComponent<HealthBar>();
        startingPos = transform.position;
        getAttackWeights = new List<attackweight>();
        bAttackDecided = false;
        rigidBody = GetComponent<Rigidbody>();
        fighterBase = GetComponent<FighterBase>();
        player = GameObject.FindGameObjectWithTag("Player");
        agent = GetComponent<NavMeshAgent>();
        animatorController = GetComponent<AnimatorController>();
        if (rigidBody && fighterBase && player && agent)
        {
            Debug.Log("All found on " + gameObject.name);
        }
        if (agent)
        { 
            agent.autoTraverseOffMeshLink = true;
            agent.autoBraking = true;
            agent.autoRepath = true;
            agent.updateRotation = true;
            agent.angularSpeed = 720.0f;
            agent.speed = fighterBase.GetStat(FighterBase.STAT.SPEED);
            
        }
        if (rigidBody)
        {
            rigidBody.isKinematic = true;
            rigidBody.useGravity = false;
        }
        if (player)
        {
            playerFighterBase = player.GetComponent<FighterBase>();
            playerCollider = player.GetComponent<CapsuleCollider>();
        }
        bCanAttack = true;
        orbitAngle = UnityEngine.Random.Range(0, 6);
        switch (fighterBase.fighter)
        {
            case FighterBase.FIGHTERCLASS.BRUTE:
                blockChance = 70;
                reactionTime = 0.4f;
                dodgeChance = 15;
                getAttackWeights.AddRange(new List<attackweight> 
                {
                    new attackweight(ATTACK.JAB, 20),
                    new attackweight(ATTACK.CROSS, 40),
                    new attackweight(ATTACK.HOOK, 60),
                    new attackweight(ATTACK.UPPERCUT, 10)
                });
                break;
            case FighterBase.FIGHTERCLASS.STRIKER:
                blockChance = 50;
                reactionTime = 0.2f;
                dodgeChance = 30;
                getAttackWeights.AddRange(new List<attackweight>
                {
                    new attackweight(ATTACK.JAB, 60),
                    new attackweight(ATTACK.CROSS, 50),
                    new attackweight(ATTACK.HOOK, 30),
                    new attackweight(ATTACK.UPPERCUT, 10)
                });
                break;
            case FighterBase.FIGHTERCLASS.LANCER:
                blockChance = 35;
                reactionTime = 0.3f;
                dodgeChance = 20;
                getAttackWeights.AddRange(new List<attackweight>
                {
                    new attackweight(ATTACK.JAB, 40),
                    new attackweight(ATTACK.CROSS, 50),
                    new attackweight(ATTACK.HOOK, 30),
                    new attackweight(ATTACK.UPPERCUT, 60)
                });
                break;
            default:
                blockChance = 55;
                reactionTime = 0.2f;
                dodgeChance = 20;
                getAttackWeights.AddRange(new List<attackweight>
                {
                    new attackweight(ATTACK.JAB, 50),
                    new attackweight(ATTACK.CROSS, 50),
                    new attackweight(ATTACK.HOOK, 50),
                    new attackweight(ATTACK.UPPERCUT, 50)
                });
                break; 

        }

        orbitAngle = UnityEngine.Random.Range(0, 360);
        orbitDirection = UnityEngine.Random.value < 0.5f ? -1f : 1f;

        
    }

    // Update is called once per frame
    void Update()
    {
        
        if (!player || !fighterBase || !agent || !agent.isOnNavMesh || hudScript.bStatScreenOpen)
        {
            return;
        }
       
         bCanAttack = fighterBase.bCanAttack;

        //change speed of animations to match movement speed
        if (animatorController != null)
        {
            float normalisedSpeed = 0.0f;
            if (agent.speed > 0)
            {
                normalisedSpeed = Mathf.Clamp01(agent.velocity.magnitude / agent.speed);
            }
            animatorController.SetMovementSpeed(normalisedSpeed);
        }

        // dont move, block, attack or dodge while stunned
        if (fighterBase.bIsStunned)
        {
            playerFighterBase.ReleaseAttackSlot(gameObject);

            agent.isStopped = true;
            bIsBlocking = false;
            bWantsToBlock = false;
            bWantsToDodge = false;
            return;
        }

        if (!bCanAttack)
        {
            agent.isStopped = true;
            return;
        }
        // set low health mode when health is a quater
        if (fighterBase.GetHealth() <= fighterBase.maxHealth * 0.25 && !bIsLowHealth)
        {
            bIsLowHealth = true;
        }
        
        // decide what to do
        DecideState();
        
        // act based on state
        switch (currentState)
        {


            case ENEMYSTATE.ATTACK:
                
                if (!bAttackDecided && !bIsLowHealth)
                {
                    currentAttack = DecideAttack();
                }
                if (bAttackDecided && !bAttackIsOnCooldown)
                {
                    agent.isStopped = false;
                    GoToPlayer(currentAttack);
                    if (!agent.pathPending && agent.remainingDistance <= agent.stoppingDistance)
                    {
                        agent.isStopped = true;
                        LookAtPlayer();
                        ThrowPunch(currentAttack);
                    }
                }
                break;


            case ENEMYSTATE.BLOCK:
                if (!bIsBlocking) 
                {
                    StartCoroutine(Block());
                }
                break;


            case ENEMYSTATE.DODGE:
                bIsBlocking = false;
                if (!bDodgeCoroutineRunning)
                {
                   StartCoroutine(Dodge());
                }
                
                break;


            case ENEMYSTATE.STUNNED:
                agent.isStopped = true;
                
                break;


            case ENEMYSTATE.DISTANCE:

                agent.isStopped = false;
                UpdateOrbit();
                
                break;

            case ENEMYSTATE.LOWHEALTH:
                LowHealthMode();
                break;


            default:
                break;
        }

    }

    //remove from attackers list
    private void OnDestroy()
    {
        if (playerFighterBase != null)
        {
            playerFighterBase.ReleaseAttackSlot(gameObject);
        }
    }

    private void DecideState()
    {
        if (bIsLowHealth)
        {
            currentState = ENEMYSTATE.LOWHEALTH;
            OutputStateChange(ENEMYSTATE.LOWHEALTH);
            
            
            return;
        }

        if (bWantsToBlock)
        {
            currentState = ENEMYSTATE.BLOCK;
            OutputStateChange(ENEMYSTATE.BLOCK);
            
            
            return;
        }

        if (bWantsToDodge)
        {
            currentState = ENEMYSTATE.DODGE;
            OutputStateChange(ENEMYSTATE.DODGE);
            
            
            return;
        }

        if (playerFighterBase.RequestAttackSlot(gameObject))
        {
            currentState = ENEMYSTATE.ATTACK;
            OutputStateChange(ENEMYSTATE.ATTACK);
            
            return;
        }
        else
        {
            currentState = ENEMYSTATE.DISTANCE;
            OutputStateChange(ENEMYSTATE.DISTANCE);
            
        }

            return;
    }
    
    //find player and go to point where attack will land
    private void GoToPlayer(ATTACK attack)
    {
        if (!fighterBase || !player || !agent)
        {
            return;
        }
        

        switch (attack)
        {
            case ATTACK.JAB:
                agent.stoppingDistance = GetAttackDistance(fighterBase.baseJabDistance); 
                break;
            case ATTACK.CROSS:
                agent.stoppingDistance = GetAttackDistance(fighterBase.baseCrossDistance);
                break;
            case ATTACK.HOOK:
                agent.stoppingDistance = GetAttackDistance(fighterBase.baseHookDistance);
                break;
            case ATTACK.UPPERCUT:
                agent.stoppingDistance = GetAttackDistance(fighterBase.baseUppercutDistance);
                break;
            default:
                agent.stoppingDistance = GetAttackDistance(fighterBase.baseJabDistance);
                break;
        }

        agent.isStopped = false;
        agent.SetDestination(player.transform.position);
    }

    //return point where punch will land
    private float GetAttackDistance(float baseAttackDistance)
    {
        
        if (!player || !fighterBase)
        {
            return 1.0f;
        }
        //increase attack distance based on reach stat
        float attackDistance = (float)(baseAttackDistance + (0.1 * fighterBase.GetStat(FighterBase.STAT.REACH)) );
        float colliderRadius = agent.radius;
        float playerRadius = playerCollider.radius;

        return (attackDistance + colliderRadius + playerRadius);

    }

    //make enemy face player
    private void LookAtPlayer()
    {
        if (!player)
        {
            return;
        }
        Vector3 looKPos = player.transform.position;
        looKPos.y = transform.position.y;
        transform.LookAt(looKPos);
    }

    // decide attack based on fighter class
    private ATTACK DecideAttack()
    {
       
        ATTACK attack;
        if (!bCanAttack || !player || !fighterBase || bAttackDecided)
        {
            return ATTACK.NULL;
        }
        if (bIsLowHealth)
        {
            LowHealthMode();
        }
        // use weighted chance to decide attacks
        int total = 0;
        foreach (attackweight weightedAttack in getAttackWeights)
        {
            total += weightedAttack.wieght;
        }
        int randomWeight = Random.Range(0, total);
        for (int i = 0; i < getAttackWeights.Count; i++)
        {
            if (randomWeight <= getAttackWeights[i].wieght)
            {
                attack = getAttackWeights[i].attack;
                bAttackDecided = true;
                return attack;
            }
            else 
            {
                randomWeight -= getAttackWeights[i].wieght;
            }
        }
        
        bAttackDecided = true;
        return ATTACK.JAB;
    }

    private void ThrowPunch(ATTACK punch)
    {
        if (bAttackIsOnCooldown || !fighterBase || fighterBase.bIsStunned)
        {
            return;
        }
        agent.isStopped = true;
        switch (punch)
        {
            case ATTACK.JAB:
                fighterBase.Jab();
                break;
            case ATTACK.CROSS:
                fighterBase.Cross();
                break;
            case ATTACK.HOOK:
                fighterBase.Hook(); 
                break;
            case ATTACK.UPPERCUT:
                fighterBase.UpperCut();
                break;
            default:
                break;
        }
        StartCoroutine(AttackCooldown(fighterBase.attackTime + 0.5f));
        
    }

    //wait between punches based on speed stat
    private IEnumerator AttackCooldown(float timer)
    {
        float recoveryTime = timer - (fighterBase.GetStat(FighterBase.STAT.SPEED) * 0.1f);
        bAttackIsOnCooldown = true;
        yield return new WaitForSeconds(recoveryTime);
        bAttackIsOnCooldown = false;
        bAttackDecided = false;
        
    }

   // play block animation, take damage to stamina instead of health
    private IEnumerator Block()
    {
        if (!fighterBase || !player)
        {
            yield break;
        }
        bIsBlocking = true;
        // How fast it reacts to players punch, based on fighter class
        yield return new WaitForSeconds(reactionTime);
        if (fighterBase.bIsStunned)
        { 
            bIsBlocking = false;
            bWantsToBlock = false;
            yield break;
        }
        fighterBase.StartBlock();
        agent.isStopped = true;
        yield return new WaitForSeconds(UnityEngine.Random.Range(0.4f, 4));
        fighterBase.StopBlock();
        agent.isStopped = false;
        bIsBlocking = false;
        bWantsToBlock = false;
    }

    //decides to block, dodge or attack after player has performed an attack 
    public void PlayerStartedAttack()
    {
        if (bIsBlocking || !fighterBase || fighterBase.bIsStunned)
        {
            return;
        }
        float rand = UnityEngine.Random.Range(0, 101);
        if (rand <= blockChance && rand > dodgeChance)
        {
            bWantsToBlock = true;
        }
        else if (rand <= dodgeChance)
        {
            bWantsToDodge = true;
        }
        else
        {
            currentState = ENEMYSTATE.ATTACK;
        }
    }

    //move gameobject backwards
    private IEnumerator Dodge()
    {
        if (!fighterBase || !player)
        {
            yield break;
        }
        bDodgeCoroutineRunning = true;
        if (fighterBase.bIsStunned)
        {
            bWantsToDodge = false;
            bDodgeCoroutineRunning = false;
            yield break;
        }
        fighterBase.Dodge();
        bWantsToDodge = false;
        bDodgeCoroutineRunning = false;
    }

    // works out the next point in a circle around the player
    private void UpdateOrbit()
    { 
        orbitUpdateTimer -= Time.deltaTime;
        bool reachedDestination = (!agent.pathPending && agent.hasPath && agent.remainingDistance <= agent.stoppingDistance + 0.25f);

        if (orbitUpdateTimer > 0f && !reachedDestination)
        {
            return;
        }
        // orbit angle between 0 and 360
        orbitAngle = Mathf.Repeat(orbitAngle + (orbitDirection * orbitStepDegrees), 360.0f);
        float angleInRadians = orbitAngle * Mathf.Deg2Rad;
        // finds a point in 360 degrees and adds radius
        Vector3 offSet = new Vector3(Mathf.Cos(angleInRadians), 0f, Mathf.Sin(angleInRadians)) * orbitRadius;
        //move centre of circle to player
        Vector3 currentDestination = player.transform.position + offSet;

        //checks if valid position, moves if it is
        if (NavMesh.SamplePosition(currentDestination, out NavMeshHit hit, 2.0f, NavMesh.AllAreas))
        {
            agent.stoppingDistance = 0.2f;
            agent.isStopped = false;
            agent.SetDestination(hit.position);
        }
        orbitUpdateTimer = updateOrbitInterval;

    }

    //apply low health mode
    private void LowHealthMode()
    {
        if (!fighterBase)
        {
            return;
        }
        switch (fighterBase.fighter)
        {
            case FighterBase.FIGHTERCLASS.BRUTE:
                BruteLowHealth();
                break;
            case FighterBase.FIGHTERCLASS.STRIKER:
                StrikerLowHealth();
                break;
            case FighterBase.FIGHTERCLASS.LANCER:
                LancerLowHealth();
                break;
            default:
                break;
        }
    }

    // close distance and attack with hook or uppercut
    private void BruteLowHealth()
    {
        
        float lowHealthBlockChance = 40;
        
        // close distance
        if (Vector3.Distance(transform.position, player.transform.position) > agent.stoppingDistance)
        {
            agent.isStopped = false;
            GoToPlayer(currentAttack);
            return;
        }
        
        // increase block chance
        float rand = UnityEngine.Random.Range(0, 100);
        if (rand <= lowHealthBlockChance)
        {
            StartCoroutine(Block());
        }
        else 
        {
            // attack with hook or uppercut
            currentAttack = UnityEngine.Random.value > 0.5 ? ATTACK.HOOK : ATTACK.UPPERCUT;
            ThrowPunch(currentAttack);
            
        }
    }

    //close distabce and Only Jab PLayer
    private void StrikerLowHealth()
    {
        
        //close distance
        if (Vector3.Distance(transform.position, player.transform.position) > agent.stoppingDistance)
        {
            agent.isStopped = false;
            GoToPlayer(currentAttack);
            return;
        }
        // Jab
        ThrowPunch(ATTACK.JAB);

    }

    //start coroutine for orbit and attack
    private void LancerLowHealth()
    {
        
        if (player == null || fighterBase == null || fighterBase.bIsStunned)
        {
            return;
        }

        if (!bLancerLowHealthCoroutineRunning)
        {
            StartCoroutine(LancerLowHealthAttackInterval(7));
        }
        

            return;
    }

    // orbit the player, stop orbit after interval and move toward player and attack
    private IEnumerator LancerLowHealthAttackInterval(float interval)
    {
        bLancerLowHealthCoroutineRunning = true;
        float orbitTimer = 0.0f;
        float orbitUpdateTimer = 0f;
        while (orbitTimer < interval)
        {
            // change point of orbit to move to every 0.25 seconds
            orbitUpdateTimer -= Time.deltaTime;
            if (orbitUpdateTimer <= 0)
            {
                UpdateOrbit();
                orbitUpdateTimer = 0.25f;
            }
            
            orbitTimer += Time.deltaTime;
            yield return null;
        }
        
        
        currentAttack = UnityEngine.Random.value > 0.5 ? ATTACK.JAB : ATTACK.CROSS;
        agent.isStopped = false;
        
        // go towards player
        while (Vector3.Distance(transform.position, player.transform.position) > agent.stoppingDistance)
        {
            GoToPlayer(currentAttack);
            yield return null;
        }
        agent.isStopped = true;
      
        //attack
        LookAtPlayer();
        ThrowPunch(currentAttack);
        
        

        while (bAttackIsOnCooldown)
        {
            yield return null;
        }

        bLancerLowHealthCoroutineRunning = false;
    }

    // test function
    private void OutputStateChange(ENEMYSTATE newState)
    {
        if (currentState == newState)
        {
            return;
        }
        Debug.Log(name + "Changed States to: " + newState);
        
    }

    //respawning enemy
    public void ResetEnemy()
    {
        fighterBase.SetHealth(fighterBase.maxHealth);
        transform.position = startingPos;
        myHealthBar.ResetHealthBar();
    }
}
